# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN A SUPABASE + IDENTIFICADOR DEL NEGOCIO (PLANTILLA)
# ==============================================================================
# Copia este archivo a .env cuando configures un entorno nuevo.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_or_publishable_key

# Slug único del cliente (ej: barberia-imperial, lumina-nails-brows, spa-aurora)
VITE_BUSINESS_ID=barberia-imperial

# Sincronizar automáticamente el archivo local src/config/business.config.ts con Supabase
VITE_AUTO_SYNC_CONFIG=true
